# ── LLM (Ollama-compatible OpenAI API) ──────────────────────────────────────
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gemma4:31b

# ── FreeScout instance ───────────────────────────────────────────────────────
FREESCOUT_URL=http://localhost:8080

# Admin credentials — used by /support to create tickets via the web UI
FREESCOUT_ADMIN_EMAIL=admin@example.com
FREESCOUT_ADMIN_PASS=Admin123!
FREESCOUT_MAILBOX_ID=1

# API key from the free mikeyperes/freescout-api-webhooks module
# Generate it at: Manage → API & Webhooks → New Key (after docker compose up)
# Used for: polling GET /api/v1/conversations + write-back PUT /api/v1/conversations/{id}
FREESCOUT_API_KEY=

# Mailbox ID for low-confidence tickets (confidence < CONFIDENCE_THRESHOLD).
# Create a dedicated "Needs Review" mailbox in FreeScout and paste its ID here.
# If left equal to FREESCOUT_MAILBOX_ID, routing is badge-only (no move).
FREESCOUT_NEEDS_REVIEW_MAILBOX_ID=1

# ── Webhook security ─────────────────────────────────────────────────────────
# HMAC secret for incoming POST /webhook requests.
# Set the same secret in whatever tool sends webhooks to your service.
# Leave blank to disable signature verification (local dev only).
WEBHOOK_SECRET=

# ── Polling ──────────────────────────────────────────────────────────────────
# How often (seconds) an external cron/scheduler should call POST /poll
POLL_INTERVAL_SECONDS=30

# ── Classifier ───────────────────────────────────────────────────────────────
# Tickets with confidence below this go to "needs-review" tag
CONFIDENCE_THRESHOLD=0.75
